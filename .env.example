# Copy to .env and replace every value before running docker compose.
# .env is gitignored and must never be committed.
#
# Passwords are embedded in a mongodb:// URI, so keep them URI-safe
# (hex or alphanumeric). Generate with: openssl rand -hex 24

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=replace-me

MONGO_APP_USERNAME=taskmanager
MONGO_APP_PASSWORD=replace-me

SECRET_KEY=replace-me
